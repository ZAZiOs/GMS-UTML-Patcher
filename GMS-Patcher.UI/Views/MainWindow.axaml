<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GMS_Patcher.UI.ViewModels"
        x:Class="GMS_Patcher.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Icon="{Binding WindowIcon}"
        Width="530" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#EFF0F1">

    <Grid>
                <Grid RowDefinitions="*, 48">
                        <Panel Grid.Row="0">
                                <Grid ColumnDefinitions="177, *" IsVisible="{Binding IsIntro}">
                    <Border Grid.Column="0" Classes="kde-banner-left">
                        <Image Source="{Binding IntroBanner}" Stretch="UniformToFill" />
                    </Border>
                    <Grid Grid.Column="1" Background="#FFFFFF" RowDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Row="0" Margin="16, 10, 12, 0">
                            <TextBlock Text="{Binding IntroTitle}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontSize="{OnPlatform Default=18, macOS=16}"
                                       FontWeight="SemiBold"
                                       Foreground="#1A1C1E" TextWrapping="Wrap"
                                       LineHeight="24" Margin="0, 0, 0, 6" />

                            <TextBlock Text="{Binding IntroSubtitle}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontSize="{OnPlatform Default=14, macOS=13}"
                                       FontWeight="Normal"
                                       Foreground="#383C40"
                                       TextWrapping="Wrap" LineHeight="20"
                                       Margin="0, 0, 0, 20" />

                                                        <Button Classes="link" Content="{Binding IntroIssuesLink}"
                                    Command="{Binding OpenIssuesUrl}"
                                    FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                    FontSize="{OnPlatform Default=14, macOS=13}"
                                    HorizontalAlignment="Left" Padding="0" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="16, 0, 14, 10" Spacing="2">
                            <TextBlock Text="{Binding IntroVersionLabel}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontSize="{OnPlatform Default=14, macOS=13}"
                                       FontWeight="Normal"
                                       Foreground="#202224" />
                            <TextBlock Text="{Binding Version}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontSize="{OnPlatform Default=14, macOS=13}"
                                       FontWeight="Normal"
                                       Foreground="#202224" />
                            <TextBlock Text="{Binding IntroNextPrompt}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontSize="{OnPlatform Default=14, macOS=13}"
                                       FontStyle="Italic"
                                       Foreground="#6E7681" Margin="0, 8, 0, 0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                                <Grid RowDefinitions="68, *" IsVisible="{Binding IsDropLink}">
                    <Border Grid.Row="0" Height="68" BorderThickness="0, 0, 0, 1" BorderBrush="#D0D4D8">
                        <Grid ColumnDefinitions="115, *">
                            <Border Grid.Column="0" Background="#000000">
                                <Image Source="{Binding HeaderBanner}" Width="90" Height="50"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="Uniform" />
                            </Border>
                            <Border Grid.Column="1" Background="#FFFFFF" Padding="12, 8">
                                <StackPanel VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="{Binding DropHeaderTitle}"
                                               FontSize="16" FontWeight="Bold" Foreground="#1A1C1E" />
                                    <TextBlock Text="{Binding DropHeaderSubtitle}"
                                               FontSize="13" Foreground="#383C40" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" RowDefinitions="Auto, *, Auto" Margin="24, 10, 24, 10">
                        <StackPanel Grid.Row="0" Spacing="8">
                            <Border Background="#FFF8E1" BorderBrush="#FFE082" BorderThickness="1" CornerRadius="3" Padding="8, 6"
                                    IsVisible="{Binding IsAdminWarningVisible}">
                                <TextBlock Text="{Binding AdminWarningText}"
                                           FontSize="10" Foreground="#795548" TextWrapping="Wrap" />
                            </Border>

                            <Grid Margin="0, 2, 0, 0">
                                <Border Name="DropZoneBorder" Classes="kde-dropzone" Margin="0, 8, 0, 0" Height="148"
                                        DragDrop.AllowDrop="True">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                                        <Image Source="{Binding CurrentDropIcon}" Width="48" Height="48" Stretch="Uniform" />
                                        <TextBlock Text="{Binding DropLabelText}" FontSize="12" Foreground="#383C40"
                                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" />
                                        <Button Classes="link" Content="{Binding DropClassicLinkText}"
                                                Command="{Binding SwitchToClassicMode}"
                                                FontSize="12" HorizontalAlignment="Center" Margin="0, 2, 0, 0" />
                                    </StackPanel>
                                </Border>

                                <Border Background="#EFF0F1" HorizontalAlignment="Left" VerticalAlignment="Top"
                                        Margin="14, 0, 0, 0" Padding="4, 0">
                                    <TextBlock Text="{Binding DropGroupBoxTitle}" FontSize="12" Foreground="#232629" />
                                </Border>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="2, 0, 0, 0" Spacing="2">
                            <TextBlock Text="{Binding SpaceRequiredText}" FontSize="12" Foreground="#232629" />
                            <TextBlock Text="{Binding SpaceAvailableText}" FontSize="12" Foreground="#232629" />
                            <TextBlock Text="{Binding CopyrightText}" FontSize="12" Foreground="#8C939A" Margin="0, 4, 0, 0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid RowDefinitions="68, *" IsVisible="{Binding IsSelectPath}">
                    <Border Grid.Row="0" Height="68" BorderThickness="0, 0, 0, 1" BorderBrush="#D0D4D8">
                        <Grid ColumnDefinitions="115, *">
                            <Border Grid.Column="0" Background="#000000">
                                <Image Source="{Binding HeaderBanner}" Width="90" Height="50"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="Uniform" />
                            </Border>
                            <Border Grid.Column="1" Background="#FFFFFF" Padding="16, 12">
                                <StackPanel VerticalAlignment="Center" Spacing="4">
                                    <TextBlock Text="{Binding PathHeaderTitle}"
                                               FontSize="16" FontWeight="Bold" Foreground="#1A1C1E" />
                                    <TextBlock Text="{Binding PathHeaderSubtitle}"
                                               FontSize="11" Foreground="#383C40" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" RowDefinitions="Auto, *, Auto" Margin="24, 14, 24, 10">
                        <StackPanel Grid.Row="0" Spacing="10">
                            <TextBlock Text="{Binding PathLabel}" FontSize="12" FontWeight="Medium" Foreground="#232629" />

                            <Grid ColumnDefinitions="*, 85">
                                <TextBox Grid.Column="0" Text="{Binding PathFieldText}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{Binding PathBrowseBtn}" Click="OnBrowseClicked" Margin="8,0,0,0"
                                        Width="80" Height="28" />
                            </Grid>

                            <Button Classes="link" Content="{Binding PathBackToDropLink}"
                                    Command="{Binding SwitchToDropMode}"
                                    FontSize="12" Margin="0, 2" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="2, 0, 0, 0" Spacing="2">
                            <Border Height="1" Background="#D8DCDE" Margin="0, 0, 0, 8" />
                            <TextBlock Text="{Binding SpaceRequiredText}" FontSize="12" Foreground="#232629" />
                            <TextBlock Text="{Binding SpaceAvailableText}" FontSize="12" Foreground="#232629" />
                            <TextBlock Text="{Binding CopyrightText}" FontSize="12" Foreground="#8C939A" Margin="0, 4, 0, 0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid RowDefinitions="68, *" IsVisible="{Binding IsInstallation}">
                    <Border Grid.Row="0" Height="68" BorderThickness="0, 0, 0, 1" BorderBrush="#D0D4D8">
                        <Grid ColumnDefinitions="115, *">
                            <Border Grid.Column="0" Background="#000000">
                                <Image Source="{Binding HeaderBanner}" Width="90" Height="50"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Stretch="Uniform" />
                            </Border>
                            <Border Grid.Column="1" Background="#FFFFFF" Padding="16, 0">
                                <Grid ColumnDefinitions="*, 85" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="{Binding InstallHeaderTitle}"
                                                   FontSize="16" FontWeight="Bold" Foreground="#1A1C1E" />
                                        <TextBlock Text="{Binding InstallHeaderSubtitle}"
                                                   FontSize="11" Foreground="#383C40" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Image Grid.Column="1" Source="{Binding StatusMascot}" Width="75" Height="60"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="20, 14" RowDefinitions="Auto, Auto, Auto, *">
                        <Grid Grid.Row="0" ColumnDefinitions="*, 60" Margin="0, 0, 0, 6">
                            <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontWeight="Medium" FontSize="11"
                                       Foreground="#232629" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#1D99F3" HorizontalAlignment="Right" />
                        </Grid>

                        <ProgressBar Grid.Row="1" Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0, 8, 0, 4">
                            <Button Classes="link" Content="{Binding DetailsButtonText, FallbackValue='Детали'}"
                                    Command="{Binding ToggleDetails}" FontSize="11" />
                        </StackPanel>

                        <TextBox Grid.Row="3" Name="LogsTextBox" Text="{Binding DetailedLogs}"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 FontSize="10" FontFamily="Consolas, Cascadia Code, Courier New, monospace"
                                 Background="#FFFFFF" BorderBrush="#B8BCBF"
                                 IsVisible="{Binding IsDetailsVisible}" Margin="0, 4, 0, 0" />
                    </Grid>
                </Grid>

                <Grid ColumnDefinitions="177, *" IsVisible="{Binding IsEndSuccess}">
                    <Border Grid.Column="0" Classes="kde-banner-left">
                        <Image Source="{Binding SuccessImage}" Stretch="UniformToFill" />
                    </Border>
                    <Grid Grid.Column="1" Background="#FFFFFF" RowDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Row="0" Margin="16, 10, 12, 0">
                            <TextBlock Text="{Binding SuccessTitle}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontSize="{OnPlatform Default=18, macOS=16}"
                                       FontWeight="SemiBold" Foreground="#1A1C1E"
                                       TextWrapping="Wrap" LineHeight="24" Margin="0, 0, 0, 6" />
                            <TextBlock Text="{Binding SuccessSubtitle}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontSize="{OnPlatform Default=14, macOS=13}"
                                       FontWeight="Normal" Foreground="#383C40"
                                       TextWrapping="Wrap" LineHeight="20" Margin="0, 0, 0, 24" />

                            <CheckBox Content="{Binding StartGameCheckbox}" IsChecked="{Binding StartGameChecked}"
                                      FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                      FontSize="{OnPlatform Default=14, macOS=13}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="16, 0, 14, 10" Spacing="2">
                            <Button Classes="link" Content="{Binding CommunityLink}"
                                    Command="{Binding OpenCommunityUrl}"
                                    FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                    FontSize="{OnPlatform Default=14, macOS=13}" HorizontalAlignment="Left" Padding="0" />
                            <TextBlock Text="{Binding SuccessFinishPrompt}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontSize="{OnPlatform Default=14, macOS=13}"
                                       FontStyle="Italic"
                                       Foreground="#6E7681" Margin="0, 4, 0, 0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid ColumnDefinitions="177, *" IsVisible="{Binding IsEndFail}">
                    <Border Grid.Column="0" Classes="kde-banner-left">
                        <Image Source="{Binding FailImage}" Stretch="UniformToFill" />
                    </Border>
                    <Grid Grid.Column="1" Background="#FFFFFF" RowDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Row="0" Margin="16, 10, 12, 0">
                            <TextBlock Text="{Binding FailTitle}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontSize="{OnPlatform Default=18, macOS=16}"
                                       FontWeight="SemiBold" Foreground="#202224"
                                       TextWrapping="Wrap" LineHeight="24" Margin="0, 0, 0, 6" />
                            <TextBlock Text="{Binding ErrorCodeText}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontSize="{OnPlatform Default=14, macOS=13}"
                                       FontWeight="SemiBold" Foreground="#202224" Margin="0, 0, 0, 6" />
                            <TextBlock Text="{Binding ErrorDetailsText}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontSize="{OnPlatform Default=14, macOS=13}"
                                       FontWeight="Normal" Foreground="#5E646A"
                                       TextWrapping="Wrap" MaxHeight="140" LineHeight="20" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Margin="16, 0, 14, 10">
                            <Border Height="1" Background="#E8EAEC" Margin="0, 0, 0, 10" />
                            <Button Classes="link" Content="{Binding FailIssuesLink}"
                                    Command="{Binding OpenIssuesUrl}"
                                    FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                    FontSize="{OnPlatform Default=14, macOS=13}" HorizontalAlignment="Left" Padding="0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Panel>

                        <Border Grid.Row="1" Classes="kde-footer" Padding="20, 0">
                <Grid VerticalAlignment="Center">
                                        <Button Content="{Binding BtnExit}" Click="OnCancelClicked" HorizontalAlignment="Left"
                            Width="85" Height="28"
                            IsVisible="{Binding ShowLeftCancelButton}"
                            IsEnabled="{Binding !IsInstallation}" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                                                <Button Content="{Binding BtnBack}" Command="{Binding GoBack}"
                                Width="85" Height="28"
                                IsVisible="{Binding ShowBackButton}"
                                IsEnabled="{Binding !IsInstallation}" />

                                                <Button Classes="primary" Content="{Binding NextButtonText}" Command="{Binding GoNext}"
                                MinWidth="85" Height="28"
                                IsVisible="{Binding ShowNextButton}"
                                IsEnabled="{Binding CanGoNext}" />

                                                <Button Content="{Binding BtnFinish}" Click="OnFinishClicked"
                                Width="95" Height="28"
                                IsVisible="{Binding IsEndSuccess}" />

                                                <Button Content="{Binding BtnExit}" Click="OnCancelClicked"
                                Width="85" Height="28"
                                IsVisible="{Binding IsEndFail}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

                <Border Background="#60000000" IsVisible="{Binding IsWarningModalVisible}">
            <Border Width="460" Background="#FFFFFF" BorderBrush="#B8BCBF" BorderThickness="1"
                    CornerRadius="6" Padding="22, 18" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 6 24 0 #50000000">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto, *">
                        <Image Grid.Column="0" Source="{Binding WarningImage}" Width="80" Height="90"
                               VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="None" Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Margin="16, 0, 0, 0" VerticalAlignment="Center" Spacing="6">
                            <TextBlock Text="{Binding WarningTitle}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontWeight="SemiBold" FontSize="14" Foreground="#1A1C1E" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding WarningSubtitle}"
                                       FontFamily="{OnPlatform Default='Segoe UI', macOS='-apple-system, BlinkMacSystemFont, SF Pro Text, Helvetica Neue'}"
                                       FontSize="12" Foreground="#383C40" TextWrapping="Wrap" LineHeight="18" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0, 4, 0, 0">
                        <Button Content="{Binding WarningCancel}" Command="{Binding CancelWarning}"
                                MinWidth="90" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        <Button Classes="primary" Content="{Binding WarningContinue}" Command="{Binding ConfirmWarning}"
                                MinWidth="110" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
