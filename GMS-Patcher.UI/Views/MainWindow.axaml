<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GMS_Patcher.UI.ViewModels"
        x:Class="GMS_Patcher.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="530" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Grid>
        <!-- Main Content Area -->
        <Grid RowDefinitions="*, 45">
            <!-- PAGE CONTENT -->
            <Panel Grid.Row="0">
                <!-- 1. INTRO PAGE -->
                <Grid ColumnDefinitions="171, *" IsVisible="{Binding IsIntro}">
                    <Border Grid.Column="0" Background="#E0E0E0">
                        <Image Source="{Binding IntroBanner}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="25, 20, 25, 10" Spacing="12">
                        <TextBlock Text="{Binding IntroTitle}" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding IntroSubtitle}" FontSize="12" Foreground="#444" TextWrapping="Wrap" />
                        <Border Height="1" Background="#DDD" Margin="0, 5" />
                        <TextBlock Text="{Binding Version}" FontSize="11" Foreground="#777" />
                        <Button Content="Возникли проблемы при установке?"
                                Command="{Binding OpenUrl}" CommandParameter="{Binding IssuesUrl}"
                                Background="Transparent" Foreground="#5865F2" Padding="0" Cursor="Hand" />
                    </StackPanel>
                </Grid>

                <!-- 2. DROP LINK PAGE -->
                <Grid RowDefinitions="70, *" IsVisible="{Binding IsDropLink}">
                    <!-- Header -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15, 10">
                        <Grid ColumnDefinitions="50, *">
                            <Image Grid.Column="0" Source="{Binding HeaderIcon}" Width="40" Height="40" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Выбор папки с игрой" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Укажите расположение файлов DELTARUNE" FontSize="11" Foreground="#666" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Body -->
                    <StackPanel Grid.Row="1" Margin="20, 15" Spacing="10">
                        <!-- Admin Warning Banner -->
                        <Border Background="#FFF3CD" BorderBrush="#FFEEBA" BorderThickness="1" CornerRadius="4" Padding="8"
                                IsVisible="{Binding IsAdminWarningVisible}">
                            <TextBlock Text="Внимание: запуск под администратором! Перетаскивание может не работать, используйте классический режим."
                                       FontSize="10" Foreground="#856404" TextWrapping="Wrap" />
                        </Border>

                        <!-- Drop Zone -->
                        <Border Name="DropZoneBorder" Height="140" CornerRadius="6"
                                BorderBrush="#B0B0B0" BorderThickness="1.5"
                                Background="White" Cursor="Hand"
                                DragDrop.AllowDrop="True">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                                <Image Source="{Binding CurrentDropIcon}" Width="42" Height="42" />
                                <TextBlock Text="{Binding DropLabelText}" FontSize="11" FontWeight="Medium"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="440" Foreground="#333" />
                                <Button Content="Не работает? Классический режим"
                                        Command="{Binding SwitchToClassicMode}"
                                        Background="Transparent" Foreground="#5865F2" FontSize="11" Padding="0" Cursor="Hand" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Disk Space Info -->
                        <Grid ColumnDefinitions="*, *" Margin="5, 0">
                            <TextBlock Grid.Column="0" Text="{Binding SpaceRequiredText}" FontSize="11" Foreground="#666" />
                            <TextBlock Grid.Column="1" Text="{Binding SpaceAvailableText}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 3. SELECT PATH PAGE -->
                <Grid RowDefinitions="70, *" IsVisible="{Binding IsSelectPath}">
                    <!-- Header -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15, 10">
                        <Grid ColumnDefinitions="50, *">
                            <Image Grid.Column="0" Source="{Binding HeaderIcon}" Width="40" Height="40" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Классический выбор пути" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Выберите папку с установленной игрой вручную" FontSize="11" Foreground="#666" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Body -->
                    <StackPanel Grid.Row="1" Margin="25, 20" Spacing="15">
                        <TextBlock Text="Укажите папку с игрой DELTARUNE:" FontSize="12" />
                        <Grid ColumnDefinitions="*, 80">
                            <TextBox Grid.Column="0" Text="{Binding PathFieldText}" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="Обзор..." Click="OnBrowseClicked" Margin="8,0,0,0"
                                    Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </Grid>

                        <Button Content="Вернуться к режиму перетаскивания"
                                Command="{Binding SwitchToDropMode}"
                                Background="Transparent" Foreground="#5865F2" FontSize="11" Padding="0" Cursor="Hand" />

                        <!-- Disk Space Info -->
                        <Grid ColumnDefinitions="*, *" Margin="0, 10, 0, 0">
                            <TextBlock Grid.Column="0" Text="{Binding SpaceRequiredText}" FontSize="11" Foreground="#666" />
                            <TextBlock Grid.Column="1" Text="{Binding SpaceAvailableText}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 4. INSTALLATION PAGE -->
                <Grid RowDefinitions="70, *" IsVisible="{Binding IsInstallation}">
                    <!-- Header -->
                    <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="15, 10">
                        <Grid ColumnDefinitions="50, *">
                            <Image Grid.Column="0" Source="{Binding HeaderIcon}" Width="40" Height="40" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="Установка модификации" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="Пожалуйста, подождите, пока файлы патча применяются..." FontSize="11" Foreground="#666" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <!-- Body -->
                    <Grid Grid.Row="1" Margin="25, 15" RowDefinitions="Auto, Auto, Auto, *">
                        <!-- Mascot & Status Text -->
                        <Grid Grid.Row="0" ColumnDefinitions="60, *" Margin="0, 0, 0, 10">
                            <Image Grid.Column="0" Source="{Binding StatusMascot}" Width="50" Height="50" HorizontalAlignment="Left" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="{Binding StatusText}" FontWeight="Medium" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!-- Progress Bar & Percentage -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, 45" VerticalAlignment="Center" Margin="0, 5">
                            <ProgressBar Grid.Column="0" Value="{Binding ProgressPercentage}" Minimum="0" Maximum="100" Height="14" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- Toggle Details Button -->
                        <Button Grid.Row="2" Content="Подробнее..." Command="{Binding ToggleDetails}"
                                Background="Transparent" Foreground="#5865F2" FontSize="11" Padding="0" Margin="0, 5" Cursor="Hand" />

                        <!-- Detailed Logs -->
                        <TextBox Grid.Row="3" Name="LogsTextBox" Text="{Binding DetailedLogs}"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 FontSize="10" FontFamily="Consolas, monospace"
                                 Background="#FAFAFA" BorderBrush="#CCC"
                                 IsVisible="{Binding IsDetailsVisible}" Margin="0, 5, 0, 0" />
                    </Grid>
                </Grid>

                <!-- 5. END SUCCESS PAGE -->
                <Grid ColumnDefinitions="171, *" IsVisible="{Binding IsEndSuccess}">
                    <Border Grid.Column="0" Background="#E0E0E0">
                        <Image Source="{Binding SuccessImage}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="25, 25, 25, 10" Spacing="15">
                        <TextBlock Text="{Binding SuccessTitle}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding SuccessSubtitle}" FontSize="12" Foreground="#444" TextWrapping="Wrap" />
                        <Border Height="1" Background="#DDD" Margin="0, 5" />
                        <Button Content="{Binding CommunityText}"
                                Command="{Binding OpenUrl}" CommandParameter="{Binding CommunityUrl}"
                                Background="Transparent" Foreground="#5865F2" FontSize="12" Padding="0" Cursor="Hand" />
                        <CheckBox Content="{Binding StartGameCheckbox}" IsChecked="{Binding StartGameChecked}"
                                  FontSize="12" Margin="0, 15, 0, 0" />
                    </StackPanel>
                </Grid>

                <!-- 6. END FAIL PAGE -->
                <Grid ColumnDefinitions="171, *" IsVisible="{Binding IsEndFail}">
                    <Border Grid.Column="0" Background="#E0E0E0">
                        <Image Source="{Binding FailImage}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="25, 25, 25, 10" Spacing="12">
                        <TextBlock Text="Ошибка при установке" FontSize="16" FontWeight="Bold" Foreground="#D32F2F" />
                        <TextBlock Text="{Binding ErrorCodeText}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ErrorDetailsText}" FontSize="11" Foreground="#555" TextWrapping="Wrap" MaxHeight="100" />
                        <Border Height="1" Background="#DDD" Margin="0, 5" />
                        <Button Content="Сообщить об ошибке на GitHub"
                                Command="{Binding OpenUrl}" CommandParameter="{Binding IssuesUrl}"
                                Background="Transparent" Foreground="#5865F2" FontSize="12" Padding="0" Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Panel>

            <!-- BOTTOM NAVIGATION BAR -->
            <Border Grid.Row="1" Background="#EEEEEE" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="15, 8">
                <Grid>
                    <!-- Left: Cancel button -->
                    <Button Content="Отмена" Click="OnCancelClicked" HorizontalAlignment="Left"
                            Width="75" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            IsVisible="{Binding !IsEndSuccess}" />

                    <!-- Right: Back / Next / Finish / Exit buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="&lt; Назад" Command="{Binding GoBack}"
                                Width="75" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                IsVisible="{Binding !IsIntro}" IsEnabled="{Binding !IsInstallation}" />

                        <Button Content="Далее &gt;" Command="{Binding GoNext}"
                                Width="75" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                IsVisible="{Binding !IsEndSuccess}" IsEnabled="{Binding CanGoNext}" />

                        <Button Content="Завершить" Click="OnFinishClicked"
                                Width="85" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#5865F2" Foreground="White"
                                IsVisible="{Binding IsEndSuccess}" />

                        <Button Content="Выход" Click="OnCancelClicked"
                                Width="75" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                IsVisible="{Binding IsEndFail}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- INTERACTIVE WARNING MODAL OVERLAY -->
        <Border Background="#80000000" IsVisible="{Binding IsWarningModalVisible}">
            <Border Width="380" Background="White" CornerRadius="8" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    BoxShadow="0 4 16 0 #40000000">
                <StackPanel Spacing="15">
                    <Grid ColumnDefinitions="45, *">
                        <Image Grid.Column="0" Source="{Binding WarningImage}" Width="40" Height="40" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4">
                            <TextBlock Text="{Binding WarningTitle}" FontWeight="Bold" FontSize="13" />
                            <TextBlock Text="{Binding WarningSubtitle}" FontSize="11" Foreground="#444" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0, 5, 0, 0">
                        <Button Content="Отменить" Command="{Binding WarningConfirm}" CommandParameter="{x:False}"
                                Width="80" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        <Button Content="Продолжить" Command="{Binding WarningConfirm}" CommandParameter="{x:True}"
                                Width="95" Height="28" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Background="#5865F2" Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>

