<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GMS_Patcher.UI.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <FluentTheme />
        <!-- Custom application styles matching form.ui -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="FontFamily" Value="Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </Application.Styles>
</Application>

